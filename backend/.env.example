# OceanIQ backend environment example
# Copy to backend/.env and replace placeholders.
# Never commit real secrets.

# MongoDB connection used for authentication and prediction history.
# Authentication requires a working MongoDB URI — there is no auth bypass.
MONGO_URI=mongodb://USERNAME:PASSWORD@HOST:27017/?authSource=admin
MONGO_DB_NAME=marine_ai_db

# Optional extra CORS origin for a deployed frontend.
FRONTEND_ORIGIN=https://your-frontend-host.example

# Session cookie settings
AUTH_COOKIE_NAME=oceaniq_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=8
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=10

# Copy this file to backend/.env and fill in the real values locally.
# NEVER commit backend/.env.
MONGO_URI=mongodb_connection_string_from_sea_state_member
MONGO_DB_NAME=marine_ai_db

# Backend authentication session settings
AUTH_COOKIE_NAME=oceaniq_session
AUTH_SESSION_HOURS=8
AUTH_COOKIE_SECURE=false
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=10
